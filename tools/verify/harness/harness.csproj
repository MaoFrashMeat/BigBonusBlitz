<Project Sdk="Microsoft.NET.Sdk">
  <!-- 100 万G のハーネス。Core だけで回し、不変条件と機械割・AT の分布を出す。実行は run.py か「dotnet run」（下の run.py 参照） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>harness</AssemblyName>
    <!-- .NET 8 のランタイムが無い PC（SDK 9 / 10 だけ）でも新しい版で動かす -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../core/core.csproj" />
    <Reference Include="UnityEngine"><HintPath>$(UnityEditorDir)/Data/Managed/UnityEngine.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>@(NewtonsoftDll)</HintPath></Reference>
  </ItemGroup>
</Project>
