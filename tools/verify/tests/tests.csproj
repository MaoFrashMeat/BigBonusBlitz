<Project Sdk="Microsoft.NET.Sdk">
  <!-- EditMode テストのコンパイルだけ（実行は Unity バッチ。docs/TASK_BOARD.md） -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BBB.Tests.EditMode</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityProj)Assets/Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../core/core.csproj" />
    <ProjectReference Include="../runtime/runtime.csproj" />
    <Reference Include="@(UnityModuleDll)" />
    <Reference Include="Unity.InputSystem"><HintPath>$(UnityLibDir)ScriptAssemblies/Unity.InputSystem.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(UnityLibDir)ScriptAssemblies/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="nunit.framework"><HintPath>@(NUnitDll)</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>@(NewtonsoftDll)</HintPath></Reference>
  </ItemGroup>
</Project>
