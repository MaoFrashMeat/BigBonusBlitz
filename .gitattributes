# 図柄・文字の元絵（assets/symbols）は LFS。1 枚 1〜2MB。
assets/symbols/**/*.png filter=lfs diff=lfs merge=lfs -text
# ボーナスのロゴ候補（assets/logo/bonus）も LFS。1 枚 1〜2MB
assets/logo/bonus/*.png filter=lfs diff=lfs merge=lfs -text
# エンゲージのロゴ候補（assets/logo/engage）も LFS
assets/logo/engage/*.png filter=lfs diff=lfs merge=lfs -text
# 参考資料（assets/refarence）も LFS。スクリーンショットが 0.5〜1MB
assets/refarence/*.png filter=lfs diff=lfs merge=lfs -text
assets/refarence/*.jpg filter=lfs diff=lfs merge=lfs -text
# 描き出し（tools/<画面>-qa）は LFS。1 枚 1〜4MB で、残すたびに履歴が重くなるため（2026-09-23）
tools/*-qa/**/*.png filter=lfs diff=lfs merge=lfs -text
